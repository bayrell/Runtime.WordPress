<class name="Runtime.WordPress.Theme.Components.Form.FormDialog"
	extends="Runtime.Widget.Dialog.Dialog"
>

<use name="Runtime.ApiResult" />
<use name="Runtime.Widget.Button" component="true" />
<use name="Runtime.Widget.RowButtons" component="true" />


<style>
.dialog_shadow{
	opacity: 0.5;
}
.dialog_title{
	display: flex;
	align-items: center;
	span{
		flex: 1;
	}
	.button{
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 34px;
		font-size: 20px;
		font-weight: bold;
		text-transform: uppercase;
		background-color: #fff;
		border: 1px #d9d9d9 solid;
		cursor: pointer;
		border-radius: 5px;
	}
}
.dialog__footer{
	align-items: center;
	justify-content: center;
}
.dialog .form__button .button{
	width: 100%;
}
.dialog .input, .dialog .textarea{
	padding: 10px;
	font-size: 16px;
	border-radius: 5px;
}
.dialog .textarea{
	min-height: 150px;
}
</style>


<template name="renderTitle">
	%if (this.model.title != "")
	{
		<span class="dialog_title__text">{{ this.model.title }}</span>
	}
</template>


<template name="renderContent">
	<div class="dialog__content">
		%render this.renderWidget(this.model.form);
	</div>
</template>


<template name="renderFooter">
	<div class="dialog__footer">
		<RowButtons>
			<Button class="button--primary" @event:click="this.onSubmitClick()">{{ this.model.submit_button_label }}</Button>
		</RowButtons>
	</div>
</template>


<script>

/**
 * On shadow click
 */
void onShadowClick()
{
	this.model.hide();
}


/**
 * Submit click
 */
async void onSubmitClick()
{
	ApiResult result = await this.model.form.submit();
	if (result.isSuccess())
	{
		this.model.hide();
	}
}

</script>


</class>